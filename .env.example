# Neon Postgres connection string. This is what the app actually reads
# from today (Drizzle + drizzle-orm/node-postgres, see src/lib/db/index.ts) —
# the project ran on local SQLite earlier in development, but that layer
# was fully removed when it migrated to Postgres.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/vacay_florence?sslmode=require"

# NextAuth v5 — signs/encrypts session JWTs. Generate a real value for any
# non-local environment: `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_TRUST_HOST="true"

# Absolute site URL — used for canonical links, Open Graph tags, and the
# generated sitemap. Set the real production domain once it exists.
NEXT_PUBLIC_SITE_URL="https://www.vacayinflorence.com"
