# Neon Postgres connection string. This is what the app actually reads
# from today (Drizzle + drizzle-orm/node-postgres, see src/lib/db/index.ts) —
# the project ran on local SQLite earlier in development, but that layer
# was fully removed when it migrated to Postgres.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/vacay_florence?sslmode=require"

# NextAuth v5 — signs/encrypts session JWTs. Generate a real value for any
# non-local environment: `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_TRUST_HOST="true"

# Absolute site URL — used for canonical links, Open Graph tags, and the
# generated sitemap. Set the real production domain once it exists.
NEXT_PUBLIC_SITE_URL="https://www.vacayinflorence.com"

# Mapbox public token — powers the interactive location map (Mapbox GL JS)
# on each experience page. Get a free token at mapbox.com; a *public* (pk.)
# token is meant to be exposed to the browser, unlike the secret token below.
# Without it, the map falls back to a generic non-fake placeholder state.
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-public-token"

# Mapbox secret server-side token — used ONLY by src/lib/geocoding.ts (server
# component / route handler code, guarded by the 'server-only' package) to
# geocode a product's saved meeting address into lat/lng when coordinates
# haven't been set directly. Never exposed to the client. Create a *secret*
# (sk.) token at mapbox.com/account/access-tokens with the 'Geocoding API'
# scope — do NOT reuse the public token above for this.
MAPBOX_SERVER_TOKEN="sk.your-mapbox-secret-token"

# Google OAuth ("Sign in with Google") — public-website customer login only
# (never staff/admin, never suppliers). Create a Web application OAuth
# client at https://console.cloud.google.com/auth/clients — Authorized
# JavaScript origins: your site's origin(s) + http://localhost:3000;
# Authorized redirect URIs: <origin>/api/auth/callback/google for each.
# While the OAuth consent screen is in "Testing" mode, only accounts added
# as test users on the Audience page can sign in.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"

# reCAPTCHA v2 ("I'm not a robot" checkbox) — protects every login/register
# form (customer, supplier, admin). Register a site at
# https://www.google.com/recaptcha/admin/create (type: Challenge (v2) ->
# "I'm not a robot" Checkbox) for your real domain(s) plus localhost.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY is safe to expose to the browser (it's what
# renders the checkbox widget); RECAPTCHA_SECRET_KEY must stay server-only.
# Auth is intentionally rejected (fail closed) if this secret is unset.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lyour-public-site-key"
RECAPTCHA_SECRET_KEY="6Lyour-server-secret-key"

# Resend — transactional email (welcome/password-setup, email verification,
# staff invite password-setup, password reset). Create an account at
# resend.com and an API key at resend.com/api-keys. RESEND_FROM_EMAIL can
# stay on the shared "onboarding@resend.dev" sender to start (works
# immediately, no DNS setup) but that sender only reliably delivers to the
# Resend account owner's own inbox — verify a real domain at
# resend.com/domains before relying on delivery to arbitrary customers.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="Your App <onboarding@resend.dev>"
