# Enforce the "engines" range in package.json (jsdom 30's Node requirement,
# via isomorphic-dompurify). Without this, an incompatible Node version only
# prints a warning during `npm install` that's easy to miss — with it,
# install fails loudly instead of silently succeeding and then crashing
# later at runtime with a cryptic jsdom/webidl error.
engine-strict=true
